# StockSense AI LLM Configuration

# Options:
# none   = no LLM, use deterministic tool-based answer
# ollama = use local Ollama server if installed
STOCKSENSE_LLM_PROVIDER=none

# Used only when STOCKSENSE_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Security Configuration
STOCKSENSE_MAX_UPLOAD_SIZE_MB=10

# Development default allows all origins.
# For production, use comma-separated frontend URLs.
STOCKSENSE_CORS_ORIGINS=*